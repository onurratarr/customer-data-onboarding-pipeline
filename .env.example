# Copy to .env (never commit .env). Everything works offline with the defaults.

# Column mapper: mock (default, offline, deterministic) or openai (any OpenAI-compatible endpoint)
MAPPER_BACKEND=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Warehouse: empty = DuckDB file in $CDOP_WORKDIR; or postgresql://user:pass@host:5432/db
WAREHOUSE_URL=
CDOP_WORKDIR=./work

# Source orders API: empty = in-process mock; or e.g. http://127.0.0.1:8765 (python -m cdop serve-api)
SOURCE_API_URL=
SOURCE_API_TOKEN=demo-token
